generator client {
  provider = "prisma-client"
  // Prisma ORM v7 requires explicit output (no longer generated into node_modules).
  // This path is relative to this schema file (`prisma/schema.prisma`).
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum OrgStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
  LEFT
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique
  displayName     String
  avatarUrl       String?
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  passwordHash    String
  passwordSalt    String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  memberships Membership[]
  auditLogs   AuditLog[]   @relation("AuditActor")
}

model Organization {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  slug      String    @unique
  status    OrgStatus @default(ACTIVE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberships Membership[]
  auditLogs   AuditLog[]
  invites     OrgInvite[]
  roles       Role[]
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @db.Uuid
  name        String
  permissions String[] // Array of permission codes
  isSystem    Boolean  @default(false) // true for built-in roles (ORG_ADMIN, etc.)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  memberships Membership[]

  @@unique([orgId, name])
  @@index([orgId])
}

model Membership {
  id              String           @id @default(uuid()) @db.Uuid
  orgId           String           @db.Uuid
  userId          String           @db.Uuid
  roleId          String?          @db.Uuid
  status          MembershipStatus @default(INVITED)
  joinedAt        DateTime?
  invitedByUserId String?          @db.Uuid
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role?        @relation(fields: [roleId], references: [id], onDelete: SetNull)

  refreshTokens RefreshToken[]

  @@unique([orgId, userId])
  @@index([orgId])
  @@index([userId])
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  tokenHash    String    @unique
  userId       String    @db.Uuid
  orgId        String    @db.Uuid
  membershipId String    @db.Uuid
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([orgId])
  @@index([membershipId])
}

model OrgInvite {
  id              String  @id @default(uuid()) @db.Uuid
  orgId           String  @db.Uuid
  email           String
  roleId          String? @db.Uuid
  invitedByUserId String? @db.Uuid

  // sha256 hash of the invite token (token itself is only shown once)
  tokenHash String @unique

  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  acceptedAt DateTime?
  declinedAt DateTime?
  revokedAt  DateTime?

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([email])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @db.Uuid
  actorUserId String?  @db.Uuid
  action      String
  targetType  String
  targetId    String?  @db.Uuid
  metadata    Json
  createdAt   DateTime @default(now())

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actor User?        @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([actorUserId])
}
