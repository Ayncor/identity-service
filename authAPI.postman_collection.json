{
  "info": {
    "_postman_id": "ayncor-identity-service-auth-api",
    "name": "Ayncor Identity Service API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Complete API documentation for identity-service: authentication, users, organizations, members, invites, roles, audit, health. Use baseUrl http://localhost:3001 for local dev. All auth endpoints require Bearer token except login, refresh, signup, and public invite endpoints."
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Liveness",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Liveness check. Returns { status: ok, ts }."
          },
          "response": []
        },
        {
          "name": "Readiness",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/ready",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health",
                "ready"
              ]
            },
            "description": "Readiness check (DB connectivity). Returns 503 if not ready."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\",\n  \"org_slug\": \"my-org\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Authenticates user and returns org-scoped access token + refresh token. Rate limited: 5/60s."
          },
          "response": []
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            },
            "description": "Refresh access token (rotate refresh token). Rate limited: 30/60s."
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "description": "Revoke refresh token. Returns 204."
          },
          "response": []
        },
        {
          "name": "Logout All",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/logout-all",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "logout-all"
              ]
            },
            "description": "Revoke all refresh tokens for current user in current org."
          },
          "response": []
        },
        {
          "name": "Password Reset Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"org_slug\": \"my-org\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/password-reset/request",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "password-reset",
                "request"
              ]
            },
            "description": "Request password reset. Always returns 202 to avoid enumeration. Rate limited: 5/60s."
          },
          "response": []
        },
        {
          "name": "Password Reset Confirm",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"<reset_token>\",\n  \"new_password\": \"newpassword123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/password-reset/confirm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "password-reset",
                "confirm"
              ]
            },
            "description": "Confirm password reset. Returns 501 Not Implemented (placeholder)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Me",
      "item": [
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "me"
              ]
            },
            "description": "Get current user + active membership + org."
          },
          "response": []
        },
        {
          "name": "List Sessions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/me/sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "me",
                "sessions"
              ]
            },
            "description": "List active sessions (devices) for current user in current org."
          },
          "response": []
        },
        {
          "name": "Revoke Session",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/me/sessions/{{sessionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "me",
                "sessions",
                "{{sessionId}}"
              ]
            },
            "description": "Revoke a session (device) by id."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Organizations",
      "item": [
        {
          "name": "Check Slug Availability",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orgs/availability/slug?slug=my-org",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orgs",
                "availability",
                "slug"
              ],
              "query": [
                {
                  "key": "slug",
                  "value": "my-org"
                }
              ]
            },
            "description": "Public. Check if team URL (slug) is available for sign-up form validation. Returns { available: boolean }. Reserved slugs (www, app, api, etc.) and taken slugs return false."
          },
          "response": []
        },
        {
          "name": "Signup",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\",\n  \"display_name\": \"John Doe\",\n  \"org_name\": \"My Org\",\n  \"org_slug\": \"my-org\",\n  \"invites\": [\n    { \"email\": \"teammate@example.com\", \"role_id\": null }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orgs/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orgs",
                "signup"
              ]
            },
            "description": "Create user + org in one transaction. Caller becomes ORG_ADMIN. Optional invites; tokens returned in invites_created (deliver out-of-band). Response same as /auth/login (access_token, refresh_token, user, membership, org). Rate limited: 5/60s. 409 when email or org_slug already taken; 400 for validation errors."
          },
          "response": []
        },
        {
          "name": "Create Organization",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Org\",\n  \"slug\": \"new-org\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orgs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orgs"
              ]
            },
            "description": "Create organization. Caller becomes ORG_ADMIN."
          },
          "response": []
        },
        {
          "name": "Get Organization",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orgs/{{orgId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orgs",
                "{{orgId}}"
              ]
            },
            "description": "Get organization by id."
          },
          "response": []
        },
        {
          "name": "Get Org Settings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orgs/{{orgId}}/settings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orgs",
                "{{orgId}}",
                "settings"
              ]
            },
            "description": "Get org settings (allowed_email_domains, require_company_email). Org admin only."
          },
          "response": []
        },
        {
          "name": "Update Org Settings",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"allowed_email_domains\": [\"example.com\"],\n  \"require_company_email\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orgs/{{orgId}}/settings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orgs",
                "{{orgId}}",
                "settings"
              ]
            },
            "description": "Update org settings. Org admin only."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Roles",
      "item": [
        {
          "name": "List Roles",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orgs/{{orgId}}/roles",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orgs",
                "{{orgId}}",
                "roles"
              ]
            },
            "description": "List roles for org (system + custom)."
          },
          "response": []
        },
        {
          "name": "Create Role",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Custom Role\",\n  \"permissions\": [\"threads:read\", \"threads:write\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orgs/{{orgId}}/roles",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orgs",
                "{{orgId}}",
                "roles"
              ]
            },
            "description": "Create custom role. Org admin only. ORG_ADMIN, ORG_MEMBER reserved."
          },
          "response": []
        },
        {
          "name": "Update Role",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Role\",\n  \"permissions\": [\"threads:read\", \"threads:write\", \"channels:read\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orgs/{{orgId}}/roles/{{roleId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orgs",
                "{{orgId}}",
                "roles",
                "{{roleId}}"
              ]
            },
            "description": "Update custom role. System roles cannot be updated."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Members",
      "item": [
        {
          "name": "Add Member",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"member@example.com\",\n  \"role_id\": \"{{roleId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orgs/{{orgId}}/members",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orgs",
                "{{orgId}}",
                "members"
              ]
            },
            "description": "Invite/add member. Creates membership (INVITED if user exists, ACTIVE if new)."
          },
          "response": []
        },
        {
          "name": "Update Member",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role_id\": \"{{roleId}}\",\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orgs/{{orgId}}/members/{{memberId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orgs",
                "{{orgId}}",
                "members",
                "{{memberId}}"
              ]
            },
            "description": "Update member (role/status). Status: ACTIVE, SUSPENDED, LEFT."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Invites",
      "item": [
        {
          "name": "Create Invite",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"invitee@example.com\",\n  \"role_id\": \"{{roleId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orgs/{{orgId}}/invites",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orgs",
                "{{orgId}}",
                "invites"
              ]
            },
            "description": "Create invite. Returns invite + one-time token (deliver out-of-band). Org admin only."
          },
          "response": []
        },
        {
          "name": "List Invites",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orgs/{{orgId}}/invites",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orgs",
                "{{orgId}}",
                "invites"
              ]
            },
            "description": "List invites for org. Org admin only."
          },
          "response": []
        },
        {
          "name": "Revoke Invite",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"invite_id\": \"{{inviteId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orgs/{{orgId}}/invites/revoke",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orgs",
                "{{orgId}}",
                "invites",
                "revoke"
              ]
            },
            "description": "Revoke an invite. Org admin only."
          },
          "response": []
        },
        {
          "name": "Verify Invite",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"<invite_token>\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orgs/{{orgId}}/invites/verify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orgs",
                "{{orgId}}",
                "invites",
                "verify"
              ]
            },
            "description": "Verify invite token (public, no auth). Returns org + invite details."
          },
          "response": []
        },
        {
          "name": "Accept Invite",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"<invite_token>\",\n  \"password\": \"password123\",\n  \"display_name\": \"John Doe\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orgs/{{orgId}}/invites/accept",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orgs",
                "{{orgId}}",
                "invites",
                "accept"
              ]
            },
            "description": "Accept invite. Creates user if needed. Returns access + refresh tokens. Rate limited: 5/60s."
          },
          "response": []
        },
        {
          "name": "Decline Invite",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"<invite_token>\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orgs/{{orgId}}/invites/decline",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orgs",
                "{{orgId}}",
                "invites",
                "decline"
              ]
            },
            "description": "Decline invite (public, no auth). Returns 204."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Audit",
      "item": [
        {
          "name": "List Audit Log",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orgs/{{orgId}}/audit?page_size=50&cursor=&action=",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orgs",
                "{{orgId}}",
                "audit"
              ],
              "query": [
                {
                  "key": "page_size",
                  "value": "50"
                },
                {
                  "key": "cursor",
                  "value": ""
                },
                {
                  "key": "action",
                  "value": ""
                }
              ]
            },
            "description": "List audit log entries. Optional action filter (prefix or exact)."
          },
          "response": []
        }
      ]
    }
  ],
