# identity-service local development env
#
# Copy to `.env` (do NOT commit `.env`).

# --- Server ---
PORT=3001

# --- Database ---
# Local Postgres via `docker compose up -d` in this repo:
# - host: localhost
# - port: 54321
# - db/user/password: identity / identity / identity
DATABASE_URL=postgresql://identity:identity@localhost:54321/identity?schema=public

# --- Dev bootstrap (creates a seed user + org in memory on startup) ---
BOOTSTRAP_EMAIL=admin@ayncor.local
BOOTSTRAP_PASSWORD=change-me-in-dev
BOOTSTRAP_ORG_SLUG=ayncor
BOOTSTRAP_ORG_NAME=AynCor

# --- Auth ---
# Used to sign/verify access JWTs. In production, store in a secrets manager and rotate.
# Generate a value (PowerShell):
#   [Convert]::ToBase64String((1..32 | ForEach-Object {Get-Random -Max 256}))
JWT_ACCESS_SECRET=replace-with-random-secret

# Access token lifetime (seconds). Default 900 = 15 minutes.
JWT_ACCESS_TTL_SECONDS=900

# Refresh token lifetime (milliseconds). Default 2592000000 = 30 days.
JWT_REFRESH_TTL_MS=2592000000

